{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "types": [],
    "lib": ["ES2022"]
  },
  "include": ["src", "test", "vitest.config.ts"],
  // Fixture flow sources are *input data* for the analyzer, not project code:
  // they import `../generated/tools` (an artifact the workspace produces) and
  // deliberately contain contract violations. Type-checking them is meaningless.
  "exclude": ["test/fixtures/**"]
}
