{
  "tools": [
    {
      "name": "github.getNewPRs",
      "label": "Get New PRs",
      "description": "Get new pull requests",
      "icon": "🐙",
      "inputSchema": {
        "repo": "string"
      },
      "outputSchema": "PullRequest[]",
      "editableFields": [
        "repo"
      ]
    },
    {
      "name": "slack.send",
      "label": "Slack Send",
      "description": "Send a Slack message",
      "icon": "💬",
      "inputSchema": {
        "channel": "string",
        "message": "string",
        "urgent": "boolean",
        "threadId": "string"
      },
      "editableFields": [
        "channel",
        {
          "name": "message",
          "editor": "expression"
        },
        "urgent",
        "threadId"
      ]
    }
  ]
}
