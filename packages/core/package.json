{
  "name": "@codeflow-team/core",
  "version": "0.3.0",
  "description": "Analyze a TypeScript agent flow into a workflow graph and patch it back byte-for-byte — domain model, tool registry, typed API codegen. Browser-safe, never executes the code it reads.",
  "keywords": [
    "codeflow",
    "workflow",
    "agent",
    "typescript",
    "ast",
    "static-analysis",
    "codegen",
    "json-schema",
    "visual-programming",
    "ts-morph"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Lucas",
  "homepage": "https://github.com/codeflow-team/codeflow/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeflow-team/codeflow.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/codeflow-team/codeflow/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
